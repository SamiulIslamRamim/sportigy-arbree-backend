// ============================================
// ENUMS
// ============================================

enum DataType {
  NUMBER
  STRING
  BOOLEAN
  PERCENTAGE
  DURATION_SECONDS
}

enum AggregationType {
  SUM
  AVERAGE
  MAX
  MIN
  LATEST
  NONE
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  // NO_RESULT
}

// ============================================
// ADMIN MANAGEMENT MODELS
// ============================================

model Sport {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  // iconUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  categories       SportCategory[]
  definitions      StatDefinition[]
  matches          Match[]
  playerMatchStats PlayerMatchStat[]
  careerSummaries  PlayerCareerSummary[]

  @@index([isActive])
  @@index([slug])
}

model SportCategory {
  id          String   @id @default(uuid())
  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  iconUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  matches          Match[]
  playerMatchStats PlayerMatchStat[]
  careerSummaries  PlayerCareerSummary[]

  @@unique([sportId, slug])
  @@index([sportId])
  @@index([isActive])
}

model StatDefinition {
  id              String          @id @default(uuid())
  sportId         String
  sport           Sport           @relation(fields: [sportId], references: [id], onDelete: Cascade)
  key             String
  label           String
  description     String?
  dataType        DataType        @default(NUMBER)
  aggregation     AggregationType @default(SUM)
  isRequired      Boolean         @default(false)
  minValue        Int?
  maxValue        Int?
  displayOrder    Int             @default(0)
  unit            String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([sportId, key])
  @@index([sportId])
  @@index([isActive])
}

// ============================================
// CORE ENTITY MODELS
// ============================================

model Player {
  id          String   @id @default(uuid())
  email       String   @unique
  fullName    String
  phone       String?
  dateOfBirth DateTime?
  nationality String?
  avatarUrl   String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  matchStats       PlayerMatchStat[]
  careerSummaries  PlayerCareerSummary[]

  @@index([isActive])
  @@index([email])
}

model Match {
  id                String      @id @default(uuid())
  sportId           String
  sport             Sport       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sportCategoryId   String
  sportCategory     SportCategory @relation(fields: [sportCategoryId], references: [id], onDelete: Restrict)
  matchDate         DateTime
  opponent          String?
  venue             String?
  tournament        String?
  matchType         String?
  homeTeam          String?
  awayTeam          String?
  matchResult       MatchResult?
  weatherCondition  String?
  notes             String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relationships
  playerMatchStats  PlayerMatchStat[]

  @@index([sportId])
  @@index([sportCategoryId])
  @@index([matchDate])
  @@index([sportId, sportCategoryId, matchDate])
}

model PlayerMatchStat {
  id                String   @id @default(uuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sportId           String
  sport             Sport    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sportCategoryId   String
  sportCategory     SportCategory @relation(fields: [sportCategoryId], references: [id], onDelete: Restrict)
  
  // Dynamic sport-specific stats stored as JSONB
  stats             Json
  
  // Context fields
  playerRole        String?
  playerTeam        String?
  isSubstitute      Boolean  @default(false)
  minutesPlayed     Int?
  performanceRating Float?
  notes             String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([matchId])
  @@index([sportId])
  @@index([sportCategoryId])
  @@index([playerId, sportId, sportCategoryId])
  @@index([playerId, sportId, createdAt])
}

// ============================================
// AGGREGATION MODELS
// ============================================

model PlayerCareerSummary {
  id                String   @id @default(uuid())
  playerId          String
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sportId           String
  sport             Sport    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sportCategoryId   String
  sportCategory     SportCategory @relation(fields: [sportCategoryId], references: [id], onDelete: Restrict)
  
  matchesPlayed     Int      @default(0)
  
  // Aggregated career stats stored as JSONB
  // Keys like: totalRuns, avgRuns, totalGoals, etc.
  careerStats       Json
  
  lastUpdated       DateTime @default(now()) @updatedAt

  @@unique([playerId, sportId, sportCategoryId])
  @@index([playerId])
  @@index([playerId, sportId])
  @@index([sportId, sportCategoryId])
}