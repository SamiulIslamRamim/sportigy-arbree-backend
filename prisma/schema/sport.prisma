model Sport {

  id String @id @default(uuid()) @db.Uuid

  name String @unique

  slug String @unique

  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  categories SportCategory[]

  fields SportField[]

  profiles PlayerSportProfile[]

  playerMatches PlayerMatch[]

  // organizations OrganizationSport[]

  @@index([slug])

  @@index([isActive])

  @@map("sports")
}

model SportCategory {

  id String @id @default(uuid()) @db.Uuid

  sportId String @map("sport_id") @db.Uuid

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  name String

  slug String

  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  playerMatches PlayerMatch[]

  @@unique([sportId, slug])

  @@index([sportId])

  @@map("sport_categories")
}


//note: store fields for player profile and sports contains. e,g, playingrole
model SportField {
  id String @id @default(uuid()) @db.Uuid

  sportId String @map("sport_id") @db.Uuid
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // PROFILE or MATCH
  section FieldSection

  // Playing Role
  // Batting Style
  // Runs
  // Goals
  name String

  // playing_role
  // batting_style
  // runs
  slug String

  type FieldType

  description String?

  required Boolean @default(false)

  searchable Boolean @default(true)

  filterable Boolean @default(true)

  sortable Boolean @default(false)

  displayOrder Int @default(0) @map("display_order")

  // Used only for MATCH fields
  //aggregation AggregationType @default(NONE)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  options SportFieldOption[]

  playerValues PlayerFieldValue[]

  matchValues PlayerMatchFieldValue[]

  @@unique([sportId, section, slug])

  @@index([sportId])

  @@index([section])

  @@index([isActive])

  @@map("sport_fields")
}
//note: add fields for player profile and sports contains. e,g, weeket keeper
model SportFieldOption {

  id String @id @default(uuid()) @db.Uuid

  fieldId String @map("field_id") @db.Uuid

  field SportField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label String

  value String

  // color String?

  // icon String?

  // displayOrder Int @default(0) @map("display_order")

  isDefault Boolean @default(false) @map("is_default")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  playerValues PlayerFieldValue[]
  matchValues  PlayerMatchFieldValue[]

  @@unique([fieldId, value])

  @@index([fieldId, isActive])

  @@map("sport_field_options")
}
//note: track sportfield & sportFieldValue for each player
model PlayerFieldValue {

  id String @id @default(uuid()) @db.Uuid

  profileId String @map("profile_id") @db.Uuid

  profile PlayerSportProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fieldId String @map("field_id") @db.Uuid

  field SportField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  optionId String? @map("option_id") @db.Uuid

  option SportFieldOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, fieldId])

  @@index([profileId])

  @@index([fieldId])

  @@index([optionId])

  @@map("player_field_values")
}

model PlayerSportProfile {

  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  player User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId String @map("sport_id") @db.Uuid

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  academy String?

  values PlayerFieldValue[]

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, sportId])

  @@index([userId, sportId])

  @@index([userId])

  @@index([sportId])

  @@map("player_sport_profiles")
}