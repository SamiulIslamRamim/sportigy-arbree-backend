model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(player)
  name         String
  contactNo    String?   @map("contact_no")
  bio          String?
  height       String?
  weight       String?
  gender       Gender?   @default(other)   
  birthday     DateTime? @db.Date
  categories   String[]
  websiteUrl   String?   @map("website_url")
  city         String?
  state        String?
  country      String
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Dynamic Multi-Sport Profiles
  // sports OrganizationSport[]
  sportProfiles PlayerSportProfile[]
  playerMatches PlayerMatch[]
  playerMatchesAsHomeTeamOrg PlayerMatch[] @relation("PlayerMatchHomeTeamOrg")
  playerMatchesAsAwayTeamOrg PlayerMatch[] @relation("PlayerMatchAwayTeamOrg")

  @@index([isActive])
  @@index([email])
  @@map("users")
}

model PasswordReset {
  id String @id @default(uuid()) @db.Uuid

  email String

  otp String

  expiresAt DateTime @map("expires_at")

  used Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])

  @@map("password_resets")
}

model PendingRegistration {
  id String @id @default(uuid()) @db.Uuid

  email String

  username String

  otp String

  payload Json

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])

  @@map("pending_registrations")
}



model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}



model OrgCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  @@map("org_categories")
}