
model PlayerMatch {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("player_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId String @map("sport_id") @db.Uuid
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Restrict)

  sportCategoryId String?        @map("sport_category_id") @db.Uuid
  sportCategory   SportCategory? @relation(fields: [sportCategoryId], references: [id], onDelete: SetNull)

  title       String?
  tournament  String?
  matchType   String? @map("match_type")
  venue       String?


  homeTeam      String?     @map("home_team")
  homeTeamOrgId String?     @map("home_team_org_id") @db.Uuid
  homeTeamOrg   User?       @relation("PlayerMatchHomeTeamOrg", fields: [homeTeamOrgId], references: [id], onDelete: SetNull)

  awayTeam      String?     @map("away_team")
  awayTeamOrgId String?     @map("away_team_org_id") @db.Uuid
  awayTeamOrg   User?       @relation("PlayerMatchAwayTeamOrg", fields: [awayTeamOrgId], references: [id], onDelete: SetNull)

  playerSide    PlayerSide? @map("player_side")

  matchDate   DateTime @map("match_date")
  result      MatchResult


  isCaptain     Boolean  @default(false) @map("is_captain")
  isSubstitute  Boolean  @default(false) @map("is_substitute")
  minutesPlayed Int?     @map("minutes_played")
  notes         String?

  status       ApprovalStatus @default(PENDING)
  reviewedBy   String?        @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?      @map("reviewed_at")
  rejectReason String?        @map("reject_reason")

  values PlayerMatchFieldValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([sportId])
  @@index([matchDate])
  @@index([status])
  @@index([userId, sportId, status])
  @@map("player_matches")
}

//note: personal data will be in option, valueNumber, valueText, valueBoolean
model PlayerMatchFieldValue {

  id String @id @default(uuid()) @db.Uuid

  playerMatchId String @map("player_match_id") @db.Uuid

  fieldId String @map("field_id") @db.Uuid

  optionId String? @map("option_id") @db.Uuid

  valueText String? @map("value_text")

  valueNumber Decimal? @db.Decimal(12,2) @map("value_number")

  valueBoolean Boolean? @map("value_boolean")

  valueDate DateTime? @db.Date @map("value_date")

  playerMatch PlayerMatch @relation(fields: [playerMatchId], references: [id], onDelete: Cascade)

  field SportField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  option SportFieldOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([playerMatchId, fieldId])

  @@index([playerMatchId])

  @@index([fieldId])

  @@map("player_match_field_values")
}


model PlayerTeamVisibility {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("player_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId String @map("sport_id") @db.Uuid
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // "org:<uuid>" for verified teams, "name:<normalized>" for free-text
  teamKey   String @map("team_key")
  teamLabel String @map("team_label")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, sportId, teamKey])
  @@map("player_team_visibility")
}